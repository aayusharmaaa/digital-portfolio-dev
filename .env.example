# ─── Copy this to .env.local and fill in your keys ───────────────────────────

# Google Gemini — https://aistudio.google.com/app/apikey
# Free tier: 15 requests/min, 1500 requests/day — plenty for a portfolio
GOOGLE_GEMINI_API_KEY=...

# ElevenLabs (Voice Cloning) — https://elevenlabs.io
# Steps: Sign up → Voices → Add Voice → Instant Voice Clone → upload 3-5 min of your voice
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# OpenAI — embeddings only (Supabase RAG). Optional if you use static fallback context.
OPENAI_API_KEY=sk-ijkl1234ijkl1234ijkl1234ijkl1234ijkl1234

# Supabase (Vector store for RAG) — https://supabase.com
# Optional — app works without this using static fallback context
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=...

# Secret for the /api/embed seeding route
EMBED_SECRET=your-random-secret-here
